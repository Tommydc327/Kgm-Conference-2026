rules_version = '2';

// Paste this into: Firebase Console -> Firestore Database -> Rules -> Publish
//
// What this enforces:
// - Anyone can ADD a registration, but only if it has the right shape
//   (correct field names/types, gender & category from the approved lists).
// - Nobody (not even a signed-in admin) can EDIT an existing registration —
//   only create or delete.
// - Only a signed-in admin (someone who logged in via admin.html) can READ
//   the list of registrations/phones, or DELETE an entry.
// - The "meta/counter" document is a single public counter used to show the
//   "X of 1000 registered" progress bar and enforce the 1000 cap. It can
//   only ever go up by exactly 1 per write, and never past CAPACITY.
//
// If you change CAPACITY in firebase-config.js, update the number 1000
// below to match.

service cloud.firestore {
  match /databases/{database}/documents {

    match /registrations/{regId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if false;
      allow create: if
        request.resource.data.keys().hasAll(['seq','fullName','phone','gender','workerStatus','branch','timestamp']) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 3 &&
        request.resource.data.fullName.size() <= 120 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30 &&
        request.resource.data.gender in ['Male', 'Female'] &&
        request.resource.data.workerStatus in ['Worker', 'Non-worker'] &&
        request.resource.data.branch is string &&
        request.resource.data.seq is number &&
        request.resource.data.timestamp is number &&
        (!("visitorFrom" in request.resource.data) ||
          (request.resource.data.visitorFrom is string && request.resource.data.visitorFrom.size() <= 200));
    }

    match /phones/{phoneId} {
      allow get: if true;
      allow list: if false;
      allow delete: if request.auth != null;
      allow update: if false;
      allow create: if
        phoneId.matches('^[0-9]+$') &&
        request.resource.data.keys().hasOnly(['regId']) &&
        request.resource.data.regId is string;
    }

    match /meta/counter {
      allow get: if true;
      allow list: if false;
      allow delete: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count is number &&
        request.resource.data.count >= 0 &&
        request.resource.data.count <= 1000 &&
        (resource == null
          ? request.resource.data.count == 1
          : request.resource.data.count == resource.data.count + 1);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
